{
  "info": {
    "_postman_id": "9c673803-46a2-47b3-8e6d-faf5de72792b",
    "name": "Online Coding Practice Platform API Collection",
    "description": "Comprehensive Postman test collection for all Auth, Problem, TestCase, Submission, Statistics, and Admin REST APIs with environment variables and response tests.",
