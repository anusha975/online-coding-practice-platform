    {
      "name": "2. Problems",
      "item": [
        {
          "name": "Get All Problems (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/problems?page=0&size=10&sortBy=id&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["problems"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "id" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Distinct Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/problems/categories", "host": ["{{baseUrl}}"], "path": ["problems", "categories"] }
          }
        },
        {
          "name": "Get Problem Details by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/problems/{{problemId}}", "host": ["{{baseUrl}}"], "path": ["problems", "{{problemId}}"] }
          }
        },
        {
          "name": "Create Problem (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.id) {",
                  "    pm.collectionVariables.set('problemId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Two Sum\",\n  \"description\": \"Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.\",\n  \"difficulty\": \"EASY\",\n  \"category\": \"Arrays\",\n  \"constraints\": \"2 <= nums.length <= 10^4\\n-10^9 <= nums[i] <= 10^9\",\n  \"inputFormat\": \"nums = [2,7,11,15], target = 9\",\n  \"outputFormat\": \"[0,1]\",\n  \"sampleInput\": \"4\\n2 7 11 15\\n9\",\n  \"sampleOutput\": \"0 1\",\n  \"timeLimitMs\": 2000,\n  \"memoryLimitMb\": 256\n}"
            },
            "url": { "raw": "{{baseUrl}}/problems", "host": ["{{baseUrl}}"], "path": ["problems"] }
          }
        },
        {
          "name": "Update Problem (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Two Sum (Updated)\",\n  \"description\": \"Updated problem statement.\",\n  \"difficulty\": \"EASY\",\n  \"category\": \"Arrays\",\n  \"timeLimitMs\": 1500,\n  \"memoryLimitMb\": 256\n}"
            },
            "url": { "raw": "{{baseUrl}}/problems/{{problemId}}", "host": ["{{baseUrl}}"], "path": ["problems", "{{problemId}}"] }
          }
        },
        {
          "name": "Delete Problem (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/problems/{{problemId}}", "host": ["{{baseUrl}}"], "path": ["problems", "{{problemId}}"] }
          }
        }
      ]
    },
