        {
          "name": "Get All Test Cases (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/problems/{{problemId}}/testcases", "host": ["{{baseUrl}}"], "path": ["problems", "{{problemId}}", "testcases"] }
          }
        }
      ]
    },
    {
      "name": "4. Submissions & Code Execution",
      "item": [
        {
          "name": "Submit Java Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.id) {",
                  "    pm.collectionVariables.set('submissionId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problemId\": {{problemId}},\n  \"language\": \"JAVA\",\n  \"sourceCode\": \"import java.util.Scanner;\\npublic class Solution {\\n    public static void main(String[] args) {\\n        Scanner sc = new Scanner(System.in);\\n        if (!sc.hasNextInt()) return;\\n        int n = sc.nextInt();\\n        int[] a = new int[n];\\n        for (int i = 0; i < n; i++) a[i] = sc.nextInt();\\n        int target = sc.nextInt();\\n        for (int i = 0; i < n; i++) {\\n            for (int j = i + 1; j < n; j++) {\\n                if (a[i] + a[j] == target) {\\n                    System.out.println(i + \\\" \\\" + j);\\n                    return;\\n                }\\n            }\\n        }\\n    }\\n}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/submissions", "host": ["{{baseUrl}}"], "path": ["submissions"] }
          }
        },
        {
          "name": "Submit Python Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problemId\": {{problemId}},\n  \"language\": \"PYTHON\",\n  \"sourceCode\": \"import sys\\ndef main():\\n    input_data = sys.stdin.read().split()\\n    if not input_data: return\\n    n = int(input_data[0])\\n    nums = [int(x) for x in input_data[1:n+1]]\\n    target = int(input_data[n+1])\\n    seen = {}\\n    for i, num in enumerate(nums):\\n        rem = target - num\\n        if rem in seen:\\n            print(f'{seen[rem]} {i}')\\n            return\\n        seen[num] = i\\nif __name__ == '__main__':\\n    main()\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/submissions", "host": ["{{baseUrl}}"], "path": ["submissions"] }
          }
        },
        {
          "name": "Get Submission Status & Verdict",
          "request": {
